# ── Core ─────────────────────────────────────────────────────────────
# Public URL used for payment callbacks and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Required in production: signs guest booking-access cookies. Generate with: openssl rand -hex 32
APP_SECRET=

# ── Database ─────────────────────────────────────────────────────────
# Leave empty to use the embedded PostgreSQL (PGlite) stored in .data/pglite.
# Set to a Postgres/Supabase connection string in production (use the pooled connection).
DATABASE_URL=
DATABASE_POOL_MAX=10
# PGLITE_DATA_DIR=.data/pglite

# ── Payments ─────────────────────────────────────────────────────────
# Paystack (https://dashboard.paystack.com/#/settings/developers). Webhook URL: /api/webhooks/paystack
PAYSTACK_SECRET_KEY=
# Flutterwave (https://dashboard.flutterwave.com). Webhook URL: /api/webhooks/flutterwave
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
# Set to "true" in production to remove the sandbox payment option.
DISABLE_DEMO_PAYMENTS=

# ── Maps (optional) ──────────────────────────────────────────────────
# Without a token, a lightweight schematic route map is used.
NEXT_PUBLIC_MAPBOX_TOKEN=

# ── Notifications (optional; messages queue in notification_outbox until set) ──
EMAIL_PROVIDER_API_KEY=
SMS_PROVIDER_API_KEY=
WHATSAPP_PROVIDER_TOKEN=
WEB_PUSH_PRIVATE_KEY=

# ── Brand ────────────────────────────────────────────────────────────
# Set to "official" after placing the supplied logo files in public/brand (logo.svg, logo-inverted.svg, icon.svg).
NEXT_PUBLIC_BRAND_ASSETS=

LOG_LEVEL=info
SEED_DEMO_DATA=
